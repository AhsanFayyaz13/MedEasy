# ─────────────────────────────────────────────────────────────
# MedEasy API — environment variables
# Copy to `.env` and fill in. Never commit real values.
# Validated at startup by config/env.js.
# ─────────────────────────────────────────────────────────────

# development | production | test  (set to production on your host!)
NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://localhost:27017/medeasy

# Long random secret for signing JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (CORS).
# https://medeasy.systems and https://www.medeasy.systems are always allowed.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# Number of reverse proxies in front of the API (Render/Vercel = 1)
TRUST_PROXY=1

# Max upload size in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880

# Resend transactional email (OTP / password reset / contact form)
RESEND_API_KEY=
SENDER_EMAIL=medeasy@medeasy.systems

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=Medeasy Uploads

