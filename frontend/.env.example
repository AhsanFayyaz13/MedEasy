# MedEasy frontend — copy to `.env` (all values are public at build time; never put secrets here)

# Backend base URL including /api
VITE_API_BASE_URL=http://localhost:5000/api

# Public site URL used for canonical links and social tags
VITE_SITE_URL=https://medeasy.systems

# true = run selected screens on local mock data (offline demos only)
VITE_USE_MOCK_API=false
